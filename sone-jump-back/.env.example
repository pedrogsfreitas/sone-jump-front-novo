# Local dev database (see README for how to start it: `npx prisma dev`)
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable

NODE_ENV=development
PORT=8080
# Origens permitidas do front, separadas por vírgula. Mais de uma porque o Vite muda
# de porta sozinho quando a 5173 já está ocupada (5174, 5175...).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Generate real secrets with: node scripts/gen-env.cjs (never commit real values)
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace-me

# Used to hash (HMAC) and encrypt (AES-256-GCM) CPF at rest. 32-byte hex strings.
CPF_HMAC_SECRET=replace-me
CPF_ENC_KEY=replace-me

# --- Recuperação de senha (opcionais) ---
# Sem RESEND_API_KEY, o e-mail é escrito no log em vez de enviado: o link de
# redefinição aparece no terminal e funciona, o que torna o fluxo testável em
# desenvolvimento sem credencial nenhuma.
# RESEND_API_KEY=
# MAIL_FROM=JUMP <nao-responda@seudominio.com>
# URL do front usada para montar o link do e-mail. Sem ela, usa a primeira origem
# de CORS_ORIGIN — que em desenvolvimento já é onde o front roda.
# APP_URL=http://localhost:5173
